{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.sighs.sophisticatedsorter.SophisticatedSorter"],
    "client": ["com.sighs.sophisticatedsorter.client.SophisticatedSorterClient"]
  },
  "mixins": ["sophisticatedsorter.mixins.json"],
  "accessWidener": "sophisticatedsorter.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=17",
    "fabric": "*",
    "cloth-config2": "*",
    "sophisticatedcore": "*"
  }
}

